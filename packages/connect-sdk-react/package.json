{
  "name": "@catenaclearing/connect-sdk-react",
  "version": "1.0.0-beta.1",
  "description": "React hook and component for Catena Connect \u2014 embed the telematics-connection flow in a React application.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catenaclearing/catena-connect-sdk.git",
    "directory": "packages/connect-sdk-react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@catenaclearing/connect-sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "catena",
    "telematics",
    "fleet",
    "embed",
    "sdk",
    "react"
  ]
}
