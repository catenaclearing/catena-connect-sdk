{
  "name": "@catenaclearing/connect-sdk",
  "version": "1.0.0-beta.2",
  "description": "Embed SDK for Catena Connect \u2014 connect fleet telematics to Catena from your own application.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catenaclearing/catena-connect-sdk.git",
    "directory": "packages/connect-sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "catena",
    "telematics",
    "fleet",
    "embed",
    "sdk"
  ]
}
