{
  "name": "catena-connect-sdk-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "check": "biome check . && pnpm check:publication && pnpm check:changesets",
    "check:fix": "biome check --write .",
    "check:publication": "node scripts/check-publication-hygiene.mjs",
    "check:changesets": "node scripts/check-changesets.mjs",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm -r build && pnpm check:publication",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
